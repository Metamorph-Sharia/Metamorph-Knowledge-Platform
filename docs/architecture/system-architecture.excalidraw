   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Tools read the retrieval indexes, and\nthe read contracts directly for whole\nprovisions, links, figures and\nindustries. No generative model runs\ninside a tool.",
   "originalText": "Tools read the retrieval indexes, and\nthe read contracts directly for whole\nprovisions, links, figures and\nindustries. No generative model runs\ninside a tool.",
