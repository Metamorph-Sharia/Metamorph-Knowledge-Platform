{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Action": "ecs:RunTask",
            "Condition": {
                "ArnLike": {
                    "ecs:cluster": "arn:aws:ecs:*:129712841299:cluster/metamorph"
                }
            },
            "Effect": "Allow",
            "Resource": "arn:aws:ecs:*:129712841299:task-definition/metamorph-*",
            "Sid": "RunMetamorphTasks"
        },
        {
            "Action": [
                "ecs:DescribeTasks",
                "ecs:StopTask",
                "ecs:TagResource"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:ecs:*:129712841299:task/metamorph/*",
            "Sid": "ManageMetamorphTasks"
        },
        {
            "Action": "ecs:DescribeTaskDefinition",
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "DescribeTaskDefinitions"
        },
        {
            "Action": [
                "ecs:UpdateService",
                "ecs:DescribeServices"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:ecs:*:129712841299:service/*/retrieval-gateway",
            "Sid": "DeployRetrievalGateway"
        },
        {
            "Action": "iam:PassRole",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "ecs-tasks.amazonaws.com"
                }
            },
            "Effect": "Allow",
            "Resource": [
                "arn:aws:iam::129712841299:role/Project3EcsTaskExecutionRole",
                "arn:aws:iam::129712841299:role/metamorph-connector-task",
                "arn:aws:iam::129712841299:role/metamorph-platform-task"
            ],
            "Sid": "PassMetamorphTaskRoles"
        },
        {
            "Action": [
                "logs:GetLogEvents",
                "logs:FilterLogEvents",
                "logs:DescribeLogStreams"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:logs:*:129712841299:log-group:/metamorph:*",
                "arn:aws:logs:*:129712841299:log-group:/metamorph/*"
            ],
            "Sid": "ReadMetamorphLogs"
        }
    ]
}
