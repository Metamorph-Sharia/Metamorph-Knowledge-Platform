{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AddedToProjectServices",
      "Effect": "Allow",
      "Action": [
        "elasticfilesystem:*",
        "servicequotas:Get*",
        "servicequotas:List*"
      ],
      "Resource": "*"
    },
    {
      "Action": [
        "elasticfilesystem:CreateFileSystem",
        "elasticfilesystem:CreateAccessPoint"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:RequestTag/Owner": "project3"
        }
      },
      "Effect": "Deny",
      "Resource": "*",
      "Sid": "EfsCreateWithOwnerTag"
    },
    {
      "Action": [
        "elasticfilesystem:Client*",
        "elasticfilesystem:Delete*",
        "elasticfilesystem:Put*",
        "elasticfilesystem:Update*",
        "elasticfilesystem:Modify*",
        "elasticfilesystem:Untag*",
        "elasticfilesystem:Replication*",
        "elasticfilesystem:Backup",
        "elasticfilesystem:Restore",
        "elasticfilesystem:CreateAccessPoint",
        "elasticfilesystem:CreateMountTarget",
        "elasticfilesystem:CreateReplicationConfiguration",
        "elasticfilesystem:CreateTags"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Owner": "project3"
        }
      },
      "Effect": "Deny",
      "Resource": "*",
      "Sid": "EfsOwnResourcesOnly"
    },
    {
      "Action": "elasticfilesystem:TagResource",
      "Condition": {
        "Null": {
          "elasticfilesystem:CreateAction": "true"
        },
        "StringNotEquals": {
          "aws:ResourceTag/Owner": "project3"
        }
      },
      "Effect": "Deny",
      "Resource": "*",
      "Sid": "EfsTagOwnResourcesOnly"
    }
  ]
}
