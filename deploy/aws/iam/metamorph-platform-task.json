{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Action": "elasticfilesystem:ClientMount",
            "Effect": "Allow",
            "Resource": "arn:aws:elasticfilesystem:*:129712841299:file-system/*",
            "Sid": "MountEfs"
        },
        {
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:s3:::metamorph-blobs-129712841299",
            "Sid": "BlobsBucket"
        },
        {
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:s3:::metamorph-blobs-129712841299/*",
            "Sid": "BlobsObjects"
        },
        {
            "Action": "s3:ListBucket",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "bundles/*"
                    ]
                }
            },
            "Effect": "Allow",
            "Resource": "arn:aws:s3:::metamorph-ops-129712841299",
            "Sid": "ListOpsBundles"
        },
        {
            "Action": "s3:GetObject",
            "Effect": "Allow",
            "Resource": "arn:aws:s3:::metamorph-ops-129712841299/bundles/*",
            "Sid": "ReadOpsBundles"
        }
    ]
}
