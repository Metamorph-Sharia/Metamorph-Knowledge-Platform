{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Action": [
                "ec2:StartInstances",
                "ec2:StopInstances"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/Name": "metamorph-mineru"
                }
            },
            "Effect": "Allow",
            "Resource": "arn:aws:ec2:*:129712841299:instance/*",
            "Sid": "StartStopMineru"
        }
    ]
}
