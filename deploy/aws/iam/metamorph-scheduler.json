{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "OpenAndCloseMineruWindow",
    "Effect": "Allow",
    "Action": ["ec2:StartInstances", "ec2:StopInstances"],
    "Resource": "arn:aws:ec2:ap-southeast-3:129712841299:instance/*",
    "Condition": {"StringEquals": {"aws:ResourceTag/Name": "metamorph-mineru", "aws:ResourceTag/Owner": "project3"}}
  }]
}
