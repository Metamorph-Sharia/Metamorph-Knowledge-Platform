{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Action": [
                "elasticfilesystem:ClientMount",
                "elasticfilesystem:ClientWrite"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:elasticfilesystem:*:129712841299:file-system/*",
            "Sid": "MountEfs"
        },
        {
            "Action": "s3:ListBucket",
            "Effect": "Allow",
            "Resource": "arn:aws:s3:::metamorph-ops-129712841299",
            "Sid": "ListOpsBucket"
        },
        {
            "Action": "s3:GetObject",
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::metamorph-ops-129712841299/inbox/*",
                "arn:aws:s3:::metamorph-ops-129712841299/transfer/*",
                "arn:aws:s3:::metamorph-ops-129712841299/backups/*"
            ],
            "Sid": "ReadOpsObjects"
        },
        {
            "Action": "s3:PutObject",
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::metamorph-ops-129712841299/transfer/*",
                "arn:aws:s3:::metamorph-ops-129712841299/backups/*"
            ],
            "Sid": "WriteOpsObjects"
        }
    ]
}
