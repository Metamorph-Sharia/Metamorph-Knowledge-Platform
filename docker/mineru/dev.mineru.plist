<?xml version="1.0" encoding="UTF-8"?>
<!-- A launchd agent that keeps the MinerU service up on this Mac (run-dev.sh). @PLATFORM@ and @HOME@ are filled
     in when it is installed: see the README, "Running MinerU". -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.metamorph.mineru</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@PLATFORM@/docker/mineru/run-dev.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/metamorph-mineru.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/metamorph-mineru.log</string>
</dict>
</plist>
