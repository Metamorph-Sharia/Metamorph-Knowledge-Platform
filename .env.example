# Copy to .env to override the local stack's dev defaults (compose.yaml). Never commit .env.
POSTGRES_USER=metamorph
POSTGRES_PASSWORD=metamorph-dev
POSTGRES_PORT=5433
S3_PORT=8333
AIRFLOW_PORT=8080

# For running `uv run metamorph …` on the host against the compose database:
METAMORPH_DATABASE_URL=postgresql://metamorph:metamorph-dev@localhost:5433/metamorph

# Object store (SeaweedFS in compose.yaml; its dev credentials are in docker/seaweedfs/s3.json).
# boto3 reads the standard AWS_* variables; in the cloud, use the platform's own credentials instead.
METAMORPH_S3_ENDPOINT_URL=http://localhost:8333
# The curation API's file links are opened by browsers: set where they reach the store, when it isn't the
# address above (the compose `api` service sets it). Unset on AWS S3.
# METAMORPH_S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
METAMORPH_S3_BUCKET=metamorph-blobs
AWS_ACCESS_KEY_ID=metamorph
AWS_SECRET_ACCESS_KEY=metamorph-dev-secret
AWS_DEFAULT_REGION=us-east-1

# Airflow (Phase 6). The DAGs bind-mount each connector repository's data/ directory, so they need host paths.
METAMORPH_WORKSPACE=/absolute/path/to/Metamorph-Sharia            # the directory holding every repository
# METAMORPH_OJK_CREDENTIALS=$HOME/.config/ojk-connector/credentials  # RegAlert token (`ojk-connector auth login`)
BI_DB_PASSWORD=bi-dev                                                # BI connector's own database (compose: postgres)
# METAMORPH_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   # failure alerts; unset: Airflow's log only

# The curation JSON API (`metamorph api`), which the curation web app calls: it signs session tokens with
# METAMORPH_WEB_SECRET.
# Each team member's account; make a password hash with
#   uv run metamorph curator hash-password
# METAMORPH_CURATORS='[{"username": "ani", "name": "Ani Rahma", "password_hash": "pbkdf2_sha256$600000$..."}]'
# METAMORPH_WEB_SECRET=   # 32+ random characters: openssl rand -hex 32
