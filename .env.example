# Copy to .env to override the local stack's dev defaults (compose.yaml). Never commit .env.
POSTGRES_USER=metamorph
POSTGRES_PASSWORD=metamorph-dev
POSTGRES_PORT=5433
S3_PORT=8333
AIRFLOW_PORT=8080

# For running `uv run metamorph …` on the host against the compose database:
METAMORPH_DATABASE_URL=postgresql://metamorph:metamorph-dev@localhost:5433/metamorph
